---
// Symboles partagés (monogramme, facultés) et filtres d'eau SVG.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <filter id="onde-survol" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence id="onde-bruit" type="turbulence" baseFrequency="0 0" numOctaves="1" seed="4" result="bruit" />
      <feDisplacementMap in="SourceGraphic" in2="bruit" scale="10" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id="ondulation" x="-5%" y="-20%" width="110%" height="140%">
      <feTurbulence type="turbulence" baseFrequency="0.008 0.09" numOctaves="1" seed="2" result="b">
        <animate attributeName="baseFrequency" dur="10s" values="0.008 0.09;0.011 0.12;0.008 0.09" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="b" scale="12" />
    </filter>
    <symbol id="sym-monogramme" viewBox="6 8 52 48">
      <path d="M14 30 V12 L32 26 L50 12 V30" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linejoin="round" stroke-linecap="round" />
      <path d="M9 32.5 q5.75 -3.5 11.5 0 t11.5 0 t11.5 0 t11.5 0" fill="none" stroke="#D6C16F" stroke-width="2.2" stroke-linecap="round" />
      <path d="M14 35 V53 L32 39 L50 53 V35" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linejoin="round" stroke-linecap="round" opacity=".45" />
    </symbol>
    <symbol id="sym-miroir" viewBox="-12 -12 24 24">
      <circle cx="0" cy="-3.6" r="6.9" fill="none" stroke="currentColor" stroke-width="1.7" />
      <path d="M-3.6 -6.6 a4.6 4.6 0 0 1 4.2 -2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path d="M-1.5 3.4 h3 l-.45 7.6 a1 1 0 0 1 -2.1 0 z" fill="currentColor" />
      <circle cx="0" cy="4.4" r="1.6" fill="currentColor" />
    </symbol>
    <symbol id="sym-etoile" viewBox="-12 -12 24 24">
      <polygon fill="currentColor" points="0,-10 1.82,-3.78 7.82,-6.23 4.09,-0.93 9.75,2.23 3.28,2.62 4.34,9.01 0,4.2 -4.34,9.01 -3.28,2.62 -9.75,2.23 -4.09,-0.93 -7.82,-6.23 -1.82,-3.78" />
    </symbol>
    <symbol id="sym-ecu" viewBox="-12 -12 24 24">
      <path d="M-8 -10 H8 V0 C8 6 3.5 9.6 0 11.2 C-3.5 9.6 -8 6 -8 0 Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
      <path d="M-4.6 6.6 L5.6 -7.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <path d="M-4.8 1.7 L0 5.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="-5.3" cy="7.6" r="1.2" fill="currentColor" />
    </symbol>
    <symbol id="sym-prisme" viewBox="-12 -12 24 24">
      <path d="M0 -10 L9 7 H-9 Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
      <path d="M-12 -1 L-2 0" stroke="currentColor" stroke-width="1.3" />
      <path d="M3 1 L12 -2 M3.4 2 L12 2 M3 3 L12 6" stroke="currentColor" stroke-width="1.1" opacity=".85" />
    </symbol>
  </defs>
</svg>
