---
import { ClientRouter } from "astro:transitions";
import Sprite from "../components/Sprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { lien } from "../lib/url";
import "../styles/global.css";

interface Props {
  titre: string;
  description: string;
  classe?: string;
}
const { titre, description, classe } = Astro.props;
const titreComplet = titre === "Mirelac" ? "Mirelac — L’université sous le lac" : `${titre} — Mirelac`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={lien("/monogramme.svg")} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <!-- Adobe Fonts : Jana Thork -->
    <link rel="stylesheet" href="https://use.typekit.net/acq3nqa.css" />
    <!-- Google Fonts : Marcellus, Alegreya, Alegreya SC (+ Uncial Antiqua en secours) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..900;1,400..900&family=Alegreya+SC:wght@400;700&family=Marcellus&family=Uncial+Antiqua&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class={classe}>
    <Sprite />
    <div class="ondes" aria-hidden="true" transition:persist="ondes"></div>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
